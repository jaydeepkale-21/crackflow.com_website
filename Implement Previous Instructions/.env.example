# CrackFlow Firebase Client Configuration
# Copy this file to .env.local and fill in your actual Firebase values from Firebase Console

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789000
VITE_FIREBASE_APP_ID=1:123456789000:web:abc123def456

# CrackFlow Cloudflare Worker Backend URL
VITE_API_BASE_URL=http://localhost:8787

