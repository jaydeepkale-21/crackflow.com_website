{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "⠀",
  "version": "0.1.0",
  "identifier": "com.system.diagnostics",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "System Diagnostics Service",
        "width": 960,
        "height": 165,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "publisher": "Audio Host Services",
    "copyright": "Copyright © Audio Host Services",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/WebView2Loader.dll": "WebView2Loader.dll"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQwNzc3OUU4NkM3MTZEMjIKUldRaWJYRnM2SGwzMENLOXhrWGx3dlVzd0hac0dSZVNXdjQ0NElHc01XdTljdjZRMG9MZHI5emQK",
      "endpoints": [
        "https://raw.githubusercontent.com/crackflow/releases/main/latest.json"
      ]
    }
  }
}
